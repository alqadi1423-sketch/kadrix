# Required: a long random secret, e.g. `openssl rand -base64 48`
AUTH_SECRET=

# Public address people use to open Veloq
BASE_URL=http://localhost:3000
PORT=3000

# Database password used by docker compose (required)
POSTGRES_PASSWORD=

# Image version to run (default: latest release)
# VELOQ_VERSION=0.1.0

# Email: daily digest of unread notifications
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Veloq <veloq@example.com>

# Reverse proxies in front of Veloq (1 behind one Nginx/Caddy hop)
TRUST_PROXY=0

# AI features stay off unless a provider is set.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=
